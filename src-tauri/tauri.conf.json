{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LUFSy",
  "version": "0.1.0",
  "identifier": "de.subqix.lufsy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LUFSy",
        "width": 1320,
        "height": 900,
        "minWidth": 980,
        "minHeight": 680,
        "backgroundColor": "#121315",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Lautstärke-Angleich für DJ-Sets",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
